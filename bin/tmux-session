#!/bin/bash

source ~/.config/bash/fzf-options.sh

active_directories=$(tmux list-sessions -F "#{session_name}")
exclude_directories=$(tmux list-sessions -f "#{session_attached}" -F "#{session_name}")

function tmux-switch-session() {
    name=$(echo $selected | sed 's/\./_/g')
    path=$(echo $selected | sed "s|~|$HOME|g")
    if [[ $TMUX ]]; then
        if ! tmux has-session -t=$name 2> /dev/null; then
            tmux new-session -ds $name -c $path
        fi
        tmux switch-client -t $name
        return
    else
        tmux new-session -A -s $name -c $path
    fi
}

function fzf-session() {
    selected=$(find-workspaces | rander session get --active $active_directories --exclude $exclude_directories | fzf --no-sort --select-1 --border-label="Select workspace" --preview='~/development/github/rander/target/release/rander session info $(echo {})')

    if [[ -z $selected ]]; then
        return
    fi

    rander session add "$selected"
    tmux-switch-session $selected
}

function previous-session() {
    selected=$(find-workspaces | rander session previous --active $active_directories --exclude $exclude_directories) 
    if [[ -z $selected ]]; then
        return
    fi
    rander session add "$selected" 0
    tmux-switch-session $selected
}

case $1 in
    previous)
        previous-session
        ;;
    *)
        fzf-session
        ;;
esac
