#!/bin/bash


source ~/.config/colors/colors.sh

export FZF_DEFAULT_OPTS="--height=10 --reverse --prompt=' ' --pointer='' --info=inline-right --border=rounded --no-scrollbar --preview-window=down,1,border-none --color=bg:-1,bg+:-1,fg:-1,hl:$yellow,fg+:$green,hl+:$yellow,info:$blue,prompt:$green,pointer:$green,marker:$blue,spinner:$blue,preview-fg:$blue"

active_directories=$(tmux list-sessions -F "#{session_name}" | sed "s|~|$HOME|")
exclude_directories=$(tmux list-sessions -f "#{session_attached}" -F "#{session_name}" | sed "s|~|$HOME|")

function tmux-switch-session() {
    selected_name=$(echo $selected | sed "s|$HOME|~|" | sed 's/\./_/g')
    if [[ $TMUX ]]; then
        # tmux kill-session -t "_wp"
        # chmod +x $selected/attach.sh
        # tmux new-session -ds "_wp" -c $selected $selected/attach.sh
        if ! tmux has-session -t=$selected_name 2> /dev/null; then
            tmux new-session -ds $selected_name -c $selected
        fi
        tmux switch-client -t $selected_name
        return
    else
        tmux new-session -A -s $selected_name -c $selected
    fi
}

function fzf-session() {
    selected=$(~/development/github/rander/target/release/rander session get --locations $1 --active $active_directories --exclude $exclude_directories | sed "s|^$HOME|~|" | fzf --no-sort --select-1 --border-label="Select workspace" --preview='~/development/github/rander/target/release/rander session info $(echo {} | sed "s|~|$HOME|")')

    if [[ -z $selected ]]; then
        return
    fi

    selected=$(echo $selected | sed "s|~|$HOME|")
    ~/development/github/rander/target/release/rander session add "$selected"
    tmux-switch-session $selected
}

function previous-session() {
    selected=$(~/development/github/rander/target/release/rander session previous --active $active_directories --exclude $exclude_directories) 
    if [[ -z $selected ]]; then
        return
    fi
    ~/development/github/rander/target/release/rander session add "$selected" 0
    tmux-switch-session $selected
}

function next-session() {
    selected=$(~/development/github/rander/target/release/rander session next --active $active_directories --exclude $exclude_directories) 
    if [[ -z $selected ]]; then
        return
    fi
    ~/development/github/rander/target/release/rander session add "$selected" 0
    tmux-switch-session $selected
}

case $1 in
    previous)
        previous-session
        ;;
    next)
        next-session
        ;;
    *)
        for i in {2..5}; do
            new_directories=$(find ~ -mindepth $i -maxdepth $i -type d -name ".git" -not -path '*/.*/*' -not -path "$directories" -exec dirname {} \;)
            directories="$directories $new_directories"
        done
        fzf-session "$directories"
        ;;
esac
