[global]
follow = keyboard
font = "Jetbrains Mono Medium"
stack_duplicates = false
corner_radius = 5
mouse_left_click=do_action
separator_color= frame
highlight = "#92A2D5"
icon_path = /usr/share/icons/Adwaita/16x16/status/:/usr/share/icons/Adwaita/16x16/devices/:/usr/share/icons/Adwaita/16x16/legacy/

[urgency_low]
background = "#1B1B1C"
foreground = "#C9C7CD"
frame_color = "#6C6874"

[urgency_normal]
background = "#1B1B1C"
foreground = "#C9C7CD"
frame_color = "#6C6874"

[urgency_critical]
background = "#1B1B1C"
foreground = "#C9C7CD"
frame_color = "#6C6874"

[ignore]
format = "<b>%a: %s</b>\n%b"
