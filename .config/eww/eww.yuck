(defpoll time :interval "1s"
    `date "+%H:%M"`)
(defpoll date :interval "5s"
    `date "+%d-%m"`)
(defpoll volume :interval "1s" "~/.config/eww/scripts/volume.sh")
(defpoll teletekst :interval "900s" "~/bin/teletekst")

(defwindow bar0
    :monitor 0
    :geometry (geometry :x "0%"
        :height "24px"
        :anchor "top center")
    :stacking "fg"
    :windowtype "dock"
    :wm-ignore false
    :class "bar0"
    (bar :name "bar0")
)

(defwindow bar1
    :monitor 1
    :geometry (geometry :x "0%"
        :height "24px"
        :anchor "top center")
    :stacking "fg"
    :windowtype "dock"
    :wm-ignore false
    (bar :name "bar1")
)

(defwindow bar2
    :monitor 2
    :geometry (geometry :x "0%"
        :height "24px"
        :anchor "top center")
    :stacking "fg"
    :windowtype "dock"
    :wm-ignore false
    (bar :name "bar2")
)

(defwidget bar [?text name]
    (box :orientation "horizontal"
        :hexpand true
        :class "bar"
        (box :orientation "horizontal"
            :halign "start"
            " 󰎕 ${teletekst}"
        )
        (box
            :tooltip date
            "${date} ${time}"
        )
        (box :orientation "horizontal"
            :space-evenly false
            :halign "end"
            :class "systray"
            "󱈑 ${EWW_BATTERY.BAT0.capacity}% | "
            {volume.muted ? " | " : " ${volume.volume}% | "}
            (systray
                :prepend-new true
                :spacing 8
                :space-evenly false
                :icon-size 16
            )
        )
    )
)
