set $w_laptop " <span foreground='#268bd2'></span> Laptop " 
set $w_terminal " <span foreground='#2aa198'></span> Terminal "
set $w_database " <span foreground='#859900'></span> Database "
set $w_phpstorm " <span foreground='#b58900'></span> Phpstorm "
set $w_browser " <span foreground='#cb4b16'></span> Browser "
set $w_slack " <span foreground='#dc322f'></span> Slack "
set $w_redis " <span foreground='#d33682'></span> Redis "

set $w1 "1:<span> </span>1 <span foreground='#268bd2'></span><span> </span>" 
set $w2 "2:<span> </span>2 <span foreground='#2aa198'></span><span> </span>"
set $w3 "3:<span> </span>3 <span foreground='#859900'></span><span> </span>"
set $w4 "4:<span> </span>4 <span foreground='#b58900'></span><span> </span>"
set $w5 "5:<span> </span>5 <span foreground='#cb4b16'></span><span> </span>"
set $w6 "6:<span> </span>6 <span foreground='#dc322f'></span><span> </span>"
set $w7 "7:<span> </span>7 <span foreground='#d33682'></span><span> </span>"
set $w8 "8:<span> </span>8 <span foreground='#6c71c4'></span><span> </span>"
set $w9 "9:<span> </span>9 <span foreground='#586e75'></span><span> </span>"
    
workspace $w_laptop output eDP-1
workspace $w_terminal output DP-3-1
workspace $w_database output DP-3-1
workspace $w_redis output DP-3-1
workspace $w_phpstorm output DP-3-1
workspace $w_browser output DP-3-2
workspace $w_slack output DP-3-2

for_window [class="kitty"] move container to workspace $w_terminal
for_window [class="beekeeper-studio"] move container to workspace $w_database
for_window [class="Redis Insight"] move container to workspace $w_redis
for_window [class="jetbrains-phpstorm"] move container to workspace $w_phpstorm
for_window [class="Google-chrome"] move container to workspace $w_browser
for_window [class="Slack"] move container to workspace $w_slack

exec --no-startup-id google-chrome
exec --no-startup-id kitty
exec --no-startup-id /snap/bin/slack
exec --no-startup-id /snap/bin/phpstorm
# exec --no-startup-id 'opt/Beekeeper Studio/beekeeper-studio'

bindsym $alt+k workspace $w_terminal;
set $leader "A"
bindsym $mod+a mode $leader
mode $leader {
    bindsym Escape mode "default"

    bindsym l workspace $w_laptop; mode "default"
    bindsym Shift+l move container to workspace $w_laptop; workspace $w_laptop; mode "default"
    bindsym t workspace $w_terminal; mode "default"
    bindsym Shift+t move container to workspace $w_terminal; workspace $w_terminal; mode "default"
    bindsym k workspace $w_terminal; mode "default"
    bindsym Shift+k move container to workspace $w_terminal; workspace $w_terminal; mode "default"
    bindsym d workspace $w_database; mode "default"
    bindsym Shift+d move container to workspace $w_database; workspace $w_database; mode "default"
    bindsym p workspace $w_phpstorm; mode "default"
    bindsym Shift+p move container to workspace $w_phpstorm; workspace $w_phpstorm; mode "default"
    bindsym b workspace $w_browser; mode "default"
    bindsym Shift+b move container to workspace $w_browser; workspace $w_browser; mode "default"
    bindsym s workspace $w_slack; mode "default"
    bindsym Shift+s move container to workspace $w_slack; workspace $w_slack; mode "default"
    bindsym r workspace $w_redis; mode "default"
    bindsym Shift+r move container to workspace $w_redis; workspace $w_redis; mode "default"

    bindsym 1 workspace $w1; mode "default"
    bindsym Shift+1 move container to workspace $w1; workspace $w1; mode "default"
    bindsym 2 workspace $w2; mode "default"
    bindsym Shift+2 move container to workspace $w2; workspace $w2; mode "default"
    bindsym 3 workspace $w3; mode "default"
    bindsym Shift+3 move container to workspace $w3; workspace $w3; mode "default"
    bindsym 4 workspace $w4; mode "default"
    bindsym Shift+4 move container to workspace $w4; workspace $w4; mode "default"
    bindsym 5 workspace $w5; mode "default"
    bindsym Shift+5 move container to workspace $w5; workspace $w5; mode "default"
    bindsym 6 workspace $w6; mode "default"
    bindsym Shift+6 move container to workspace $w6; workspace $w6; mode "default"
    bindsym 7 workspace $w7; mode "default"
    bindsym Shift+7 move container to workspace $w7; workspace $w7; mode "default"
    bindsym 8 workspace $w8; mode "default"
    bindsym Shift+8 move container to workspace $w8; workspace $w8; mode "default"
    bindsym 9 workspace $w9; mode "default"
    bindsym Shift+9 move container to workspace $w9; workspace $w9; mode "default"
}
